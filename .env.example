# CrownPath staging/production configuration
CROWNPATH_ENV=development

# Required in production:
CROWNPATH_DATABASE_URL=
CROWNPATH_SECRET_KEY=

# Business audio integration. Never put a personal Pandora password here.
CROWNPATH_PANDORA_BUSINESS_REFERENCE=
CROWNPATH_PLAYBACK_PROVIDER=

# Final release gates
CROWNPATH_REQUIRE_HTTPS=true
CROWNPATH_DEMO_MODE=true
CROWNPATH_BACKUP_RESTORE_VERIFIED=false
CROWNPATH_SECURITY_TESTS_VERIFIED=false
CROWNPATH_OWNER_LAUNCH_APPROVED=false
